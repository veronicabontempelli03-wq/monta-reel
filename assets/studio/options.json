{
  "title": "Studio reel",
  "sample": "Ciao",
  "presets": [
    {
      "label": "Pop",
      "hint": "Cal Sans giallo, parole in evidenza colorate che rimbalzano",
      "captions": {
        "style": "pop"
      }
    },
    {
      "label": "Clean",
      "hint": "Bianco, una parola alla volta, evidenza in corsivo giallo",
      "captions": {
        "style": "clean"
      }
    },
    {
      "label": "Bold",
      "hint": "Montserrat Black in maiuscolo",
      "captions": {
        "style": "clean",
        "font": "montserrat",
        "emphFont": "montserrat",
        "case": "upper",
        "emphItalic": false,
        "shadow": "soft"
      }
    },
    {
      "label": "Impatto",
      "hint": "Anton alto e stretto, bianco e giallo",
      "captions": {
        "style": "pop",
        "font": "anton",
        "emphFont": "anton",
        "case": "upper",
        "color": "#FFFFFF",
        "emphColor": "#FFE14D",
        "shadow": "strong"
      }
    },
    {
      "label": "Editorial",
      "hint": "Inter pulito con evidenze in serif corsivo",
      "captions": {
        "style": "clean",
        "emphFont": "dmserif",
        "emphCase": "asis",
        "emphItalic": true
      }
    },
    {
      "label": "Box",
      "hint": "Poppins su un box scuro, si legge su qualsiasi sfondo",
      "captions": {
        "style": "clean",
        "font": "poppins",
        "emphFont": "poppins",
        "shadow": "box",
        "emphItalic": false
      }
    },
    {
      "label": "Arco",
      "hint": "Minuscolo giallo pallido ad arco sopra la testa; la chiusa in serif corsivo",
      "captions": {
        "style": "clean",
        "font": "montserrat-m",
        "emphFont": "dmserif",
        "color": "#F6EB8F",
        "emphColor": "#F6EB8F",
        "case": "lower",
        "emphCase": "upper",
        "emphItalic": true,
        "shadow": "light",
        "anim": "soft",
        "size": 86,
        "emphSize": 132,
        "y": 430,
        "curve": 210,
        "tilt": 6
      }
    },
    {
      "label": "Arco bianco",
      "hint": "Stessa curva ma piccolo e bianco, più discreto",
      "captions": {
        "style": "clean",
        "font": "montserrat-m",
        "emphFont": "montserrat-m",
        "color": "#FFFFFF",
        "emphColor": "#F6EB8F",
        "case": "lower",
        "emphCase": "lower",
        "emphItalic": false,
        "shadow": "light",
        "anim": "soft",
        "size": 54,
        "emphSize": 84,
        "y": 430,
        "curve": 170,
        "tilt": 8
      }
    },
    {
      "label": "Cinema",
      "hint": "Una parola color crema con ombra a metà altezza e colore cinema (verde salvia, pelle dorata, grana)",
      "captions": {
        "style": "clean",
        "font": "inter",
        "emphFont": "inter",
        "color": "#F3DCA7",
        "emphColor": "#F3DCA7",
        "case": "lower",
        "emphCase": "lower",
        "emphItalic": false,
        "shadow": "soft",
        "anim": "soft",
        "size": 112,
        "emphSize": 132,
        "y": 1120
      },
      "set": {
        "grade": "cine"
      }
    },
    {
      "label": "Girly",
      "hint": "Bianco bold sopra la testa, evidenza rosa baby con brillantini e uno sticker che appare",
      "captions": {
        "style": "clean",
        "font": "montserrat-b",
        "emphFont": "montserrat-b",
        "color": "#FFFFFF",
        "emphColor": "#F9B4D0",
        "case": "asis",
        "emphCase": "asis",
        "emphItalic": false,
        "shadow": "light",
        "anim": "soft",
        "size": 62,
        "emphSize": 92,
        "y": 420,
        "sparkles": true,
        "emphStickers": "girly"
      }
    },
    {
      "label": "Girly serif",
      "hint": "Uguale, con l'evidenza in serif corsivo giallo pallido",
      "captions": {
        "style": "clean",
        "font": "montserrat-b",
        "emphFont": "dmserif",
        "color": "#FFFFFF",
        "emphColor": "#F8EDA8",
        "case": "asis",
        "emphCase": "asis",
        "emphItalic": true,
        "shadow": "light",
        "anim": "soft",
        "size": 62,
        "emphSize": 100,
        "y": 420,
        "sparkles": true,
        "emphStickers": "girly"
      }
    }
  ],
  "presetKeys": [
    "style",
    "font",
    "emphFont",
    "color",
    "emphColor",
    "case",
    "emphCase",
    "emphItalic",
    "shadow",
    "anim",
    "emphSfx",
    "size",
    "emphSize",
    "y",
    "curve",
    "tilt",
    "emphBox",
    "sparkles",
    "emphStickers"
  ],
  "groups": [
    {
      "label": "Colore dell'immagine",
      "controls": [
        {
          "key": "grade",
          "label": "Look",
          "type": "segment",
          "choices": [
            {
              "v": null,
              "label": "Natural"
            },
            {
              "v": "cine",
              "label": "Cinema",
              "dot": "#7E9C86"
            },
            {
              "v": "calido",
              "label": "Caldo",
              "dot": "#E2A35C"
            },
            {
              "v": "film",
              "label": "Film slavato",
              "dot": "#B9B3A0"
            },
            {
              "v": "frio",
              "label": "Freddo",
              "dot": "#6F8FB0"
            }
          ],
          "hint": "Nell'anteprima la prima volta ci mette qualche secondo; nel render si applica sul 4K"
        },
        {
          "key": "gradeAmount",
          "label": "Intensità",
          "type": "range",
          "min": 0.2,
          "max": 1.5,
          "step": 0.1,
          "unit": "×"
        }
      ]
    },
    {
      "label": "Font",
      "controls": [
        {
          "key": "captions.font",
          "label": "Sottotitoli",
          "type": "font",
          "choices": "fonts"
        },
        {
          "key": "captions.emphFont",
          "label": "Parole in evidenza",
          "type": "font",
          "choices": "fonts"
        },
        {
          "key": "titleFont",
          "label": "Titoli dietro la testa",
          "type": "font",
          "choices": "fonts"
        }
      ]
    },
    {
      "label": "Colore",
      "controls": [
        {
          "key": "captions.color",
          "label": "Sottotitoli",
          "type": "color",
          "choices": [
            "#FFFFFF",
            "#FFD60A",
            "#FFE14D",
            "#F6EB8F",
            "#F5F0E6",
            "#F3DCA7"
          ]
        },
        {
          "key": "captions.emphColor",
          "label": "Parole in evidenza",
          "type": "color",
          "choices": [
            null,
            "#E2577F",
            "#E07A4F",
            "#9B7FD8",
            "#E8B53E",
            "#7FA86A",
            "#FFE14D",
            "#F6EB8F",
            "#F9B4D0",
            "#F8EDA8",
            "#F3DCA7",
            "#BBCDF3",
            "#FAE271",
            "#ACD56B",
            "#2A5B98",
            "#FFFFFF"
          ],
          "nullLabel": "Un colore per ogni evidenza (ruota la palette)"
        }
      ]
    },
    {
      "label": "Testo",
      "controls": [
        {
          "key": "captions.case",
          "label": "Maiuscole",
          "type": "segment",
          "choices": [
            {
              "v": "asis",
              "label": "Come detto"
            },
            {
              "v": "auto",
              "label": "minuscolo all'inizio"
            },
            {
              "v": "upper",
              "label": "MAIUSCOLO"
            },
            {
              "v": "lower",
              "label": "minuscolo"
            }
          ]
        },
        {
          "key": "captions.emphCase",
          "label": "Parole in evidenza",
          "type": "segment",
          "choices": [
            {
              "v": "upper",
              "label": "MAIUSCOLO"
            },
            {
              "v": "asis",
              "label": "Come detto"
            }
          ]
        },
        {
          "key": "captions.emphItalic",
          "label": "Evidenza in corsivo",
          "type": "toggle"
        },
        {
          "key": "captions.shadow",
          "label": "Leggibilità",
          "type": "segment",
          "choices": [
            {
              "v": "light",
              "label": "Ombra morbida"
            },
            {
              "v": "soft",
              "label": "Ombra"
            },
            {
              "v": "strong",
              "label": "Ombra forte"
            },
            {
              "v": "box",
              "label": "Box"
            },
            {
              "v": "none",
              "label": "Niente"
            }
          ]
        },
        {
          "key": "captions.emphBox",
          "label": "Evidenza su",
          "type": "segment",
          "choices": [
            {
              "v": null,
              "label": "Niente"
            },
            {
              "v": "pill",
              "label": "Pillola di colore"
            }
          ]
        },
        {
          "key": "captions.sparkles",
          "label": "Brillantini ✦ sulle parole in evidenza",
          "type": "toggle"
        },
        {
          "key": "captions.emphStickers",
          "label": "Sticker su ogni parola in evidenza",
          "type": "segment",
          "choices": [
            {
              "v": null,
              "label": "Nessuno"
            },
            {
              "v": "girly",
              "label": "Pack girly (stelle, cuori, brillantini)"
            }
          ],
          "hint": "I pack stanno in ~/reel-stickers (scripts/stickers.py cut)"
        }
      ]
    },
    {
      "label": "Dimensione e posizione",
      "controls": [
        {
          "key": "captions.size",
          "label": "Sottotitoli",
          "type": "range",
          "min": 56,
          "max": 130,
          "step": 2,
          "unit": "px"
        },
        {
          "key": "captions.emphSize",
          "label": "Parole in evidenza",
          "type": "range",
          "min": 90,
          "max": 200,
          "step": 2,
          "unit": "px"
        },
        {
          "key": "captions.y",
          "label": "Altezza",
          "type": "range",
          "min": 260,
          "max": 1400,
          "step": 10,
          "unit": "px",
          "hint": "Sopra la testa (300-500) per l'arco; all'altezza del petto (1150-1300) per il resto"
        },
        {
          "key": "captions.curve",
          "label": "Curva (arco)",
          "type": "range",
          "min": 0,
          "max": 300,
          "step": 10,
          "unit": "px",
          "hint": "0 = dritto. Con la curva il sottotitolo si piega come un'aureola"
        },
        {
          "key": "captions.tilt",
          "label": "Inclinazione",
          "type": "range",
          "min": 0,
          "max": 12,
          "step": 1,
          "unit": "°"
        }
      ]
    },
    {
      "label": "Movimento e suono",
      "controls": [
        {
          "key": "captions.anim",
          "label": "Entrata delle parole",
          "type": "segment",
          "choices": [
            {
              "v": "pop",
              "label": "Pop con rimbalzo"
            },
            {
              "v": "soft",
              "label": "Morbido"
            },
            {
              "v": "none",
              "label": "Nessuna animazione"
            }
          ]
        },
        {
          "key": "autoZoom",
          "label": "Zoom camera su ogni parola in evidenza",
          "type": "toggle"
        },
        {
          "key": "captions.emphSfx",
          "label": "Suono sulle parole in evidenza",
          "type": "segment",
          "choices": [
            {
              "v": "pop",
              "label": "Pop"
            },
            {
              "v": "click",
              "label": "Click"
            },
            {
              "v": "ding",
              "label": "Ding"
            },
            {
              "v": null,
              "label": "Nessuno"
            }
          ]
        },
        {
          "key": "sfx.gain",
          "label": "Volume degli effetti",
          "type": "range",
          "min": 0,
          "max": 1.5,
          "step": 0.1,
          "unit": "×"
        }
      ]
    }
  ],
  "fonts": [
    {
